---
import '../styles/site.css';
import header from '../fragments/header.html?raw';
import footer from '../fragments/footer.html?raw';
import dialog from '../fragments/dialog.html?raw';
import {getSiteData} from '../lib/data.mjs';
const {title='项目与技术笔记',description='严凯丰的个人网站，记录全栈开发、AI Agent 应用与本科课程实验。',active='home'}=Astro.props;
const dataset=await getSiteData();
const searchData=[...dataset.projects.map(p=>({title:p.title,type:'项目',summary:p.summary,text:p.cn+' '+p.tags.join(' ')+' '+p.body,url:'/projects/'+p.slug+'/'})),...dataset.articles.map(a=>({title:a.title,type:'技术笔记',summary:a.summary,text:a.cn+' '+a.tags.join(' ')+' '+a.body,url:'/writing/'+a.slug+'/'}))];
const headerHtml=header.replace(new RegExp('data-nav="'+active+'"'),'data-nav="'+active+'" class="active" aria-current="page"');
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#fbfcfa"/><title>{title} — 严凯丰</title><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="alternate" type="application/rss+xml" title="严凯丰的技术笔记" href="/rss.xml"/><meta property="og:title" content={title+' — 严凯丰'}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/social-card.svg',Astro.site)}/><meta name="twitter:card" content="summary_large_image"/></head><body><a class="skip-link" href="#main">跳至正文</a><Fragment set:html={headerHtml}/><main id="main" class="site-main" tabindex="-1"><slot/></main><Fragment set:html={footer}/><Fragment set:html={dialog}/><script type="application/json" id="search-data" set:html={JSON.stringify(searchData).replaceAll('<','\u003c')}/><script>import '../scripts/site.js';</script></body></html>
