---
import {getCollection,render} from 'astro:content';
import Site from '../../layouts/Site.astro';
export async function getStaticPaths(){return (await getCollection('writing')).map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const a=entry.data;const {Content,headings}=await render(entry);
---
<Site title={a.title} description={a.summary} active="writing"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/writing/">Writing</a><span>/</span><span aria-current="page">{a.tags[0]}</span></nav><header class="article-head"><div class="eyebrow">{a.category}</div><h1>{a.title}</h1><p class="article-cn" lang="zh">{a.cn}</p><div class="article-meta"><span>KAIFENG YAN</span><span>·</span><span>{a.year} COURSE LAB</span><span>·</span><span>{a.readTime.toUpperCase()} READ</span><span class="draft-label">ARCHIVE NOTE</span></div><div class="chips">{a.tags.map(t=><a class="chip" href={'/writing/?tag='+encodeURIComponent(t)}>{t}</a>)}</div><p class="article-deck">{a.summary}</p></header><p class="editor-note">Historical course record, edited in October 2026. The original environment has not been rerun for this article. Inspection commands and edited examples are identified separately from recorded lab results.</p><div class="article-layout"><article class="article-body"><Content/><footer class="article-foot"><p><strong>Source:</strong> {a.source}<br/>Published {a.published}. Original identifiers, addresses, and credentials are omitted.</p><a href="/categories/cloud-computing/">← Back to the collection</a></footer></article><nav class="article-toc" aria-label="On this page"><h2>ON THIS PAGE</h2>{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug} data-toc={h.slug}>{h.text.replace(/^\d+ \/ /,'')}</a>)}</nav></div></Site>
